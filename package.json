{
  "name": "pirate-clashers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "start:phone": "node scripts/serve-phone.cjs",
    "build": "node scripts/build-game.cjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/model.js && node --check src/app.js",
    "publish:play": "npm test && node scripts/publish-play.cjs",
    "package:web": "npm run build && npm test && npm run check && python scripts/package-web.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
